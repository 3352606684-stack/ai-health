# 默认按内容自动判断文本文件（配合 core.autocrlf）
* text=auto

# 明确声明二进制，避免被当作文本做换行转换而损坏
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary
*.zip binary
*.pdf binary

# 脚本保持 LF，避免在 Linux/CI 上因 CRLF 执行失败
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
